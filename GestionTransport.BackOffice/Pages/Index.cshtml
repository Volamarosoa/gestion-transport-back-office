@page
@model IndexModel
@{
    ViewData["Title"] = "Tableau de bord";
}

<!-- Statistics Cards -->
<div class="col-md-6 col-xl-3">
    <div class="card daily-sales">
        <div class="card-body pb-0">
            <h2 class="m-0">24</h2>
            <span class="text-c-blue">Transports aujourd'hui</span>
            <p class="mb-3 mt-3">Nombre total de transports effectués aujourd'hui.</p>
        </div>
        <div class="card-footer bg-primary text-white">
            <div class="row text-center">
                <div class="col">
                    <h4 class="m-0 text-white">10</h4>
                    <span>En cours</span>
                </div>
                <div class="col">
                    <h4 class="m-0 text-white">12</h4>
                    <span>Terminés</span>
                </div>
                <div class="col">
                    <h4 class="m-0 text-white">2</h4>
                    <span>Annulés</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="col-md-6 col-xl-3">
    <div class="card">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-8">
                    <h4 class="text-c-yellow">108</h4>
                    <h6 class="text-muted m-b-0">Total des transports mois d'avril</h6>
                </div>
                <div class="col-4 text-right">
                    <i class="feather icon-bar-chart-2 f-28"></i>
                </div>
            </div>
        </div>
        <div class="card-footer bg-c-yellow">
            <div class="row align-items-center">
                <div class="col-9">
                    <p class="text-white m-b-0">+18% ce mois</p>
                </div>
                <div class="col-3 text-right">
                    <i class="feather icon-trending-up text-white f-16"></i>
                </div>
            </div>
        </div>
    </div>
</div>