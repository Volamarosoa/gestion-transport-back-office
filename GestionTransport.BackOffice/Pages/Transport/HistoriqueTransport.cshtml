@page
@model GestionTransport.BackOffice.Pages.Transport.HistoriqueTransportModel
@{
    ViewData["Title"] = "Historique des Transports";
}

@* ===== ALERTES ===== *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>@TempData["Success"]</strong>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>@Html.Raw(TempData["Error"]?.ToString()?.Replace("\n", "<br/>"))</strong>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="col-xl-12">
    <div class="card table-card">
        <div class="card-header">
            <h5>
                <i class="feather icon-clock mr-2"></i>
                Historique des Transports 
                <span class="badge bg-success ml-2">validées</span>
            </h5>

            @* Dans le card-header, à côté des filtres *@
            <form method="post" asp-page-handler="AffectationAuto" style="display:inline;">
                <input type="hidden" name="pageActuelle" value="@Model.PageActuelle" />
                <input type="hidden" name="dateTransportFiltre" value="@Model.DateTransportFiltre?.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="typeTransportFiltre" value="@Model.TypeTransportFiltre" />
                <button type="submit" class="btn btn-sm btn-warning"
                        onclick="return confirm('Lancer l\'affectation automatique des véhicules ?')">
                    <i class="feather icon-zap mr-1"></i> Affectation automatique
                </button>
            </form>

            <div class="card-header-right">
                @* ===== FILTRES ===== *@
                
                <form method="get" class="d-flex align-items-center" style="gap: 8px; margin-right: 10px;">
                    <input type="text"
                           name="recherche"
                           value="@Model.Recherche"
                           class="form-control form-control-sm"
                           placeholder="Rechercher un employé..."
                           style="width: 200px;" />

                    <input type="date"
                           name="dateTransportFiltre"
                           value="@Model.DateTransportFiltre?.ToString("yyyy-MM-dd")"
                           class="form-control form-control-sm"
                           style="width: 160px;" />

                    <select name="typeTransportFiltre" class="form-control form-control-sm" style="width: 120px;">
                        <option value="">Tous</option>
                        <option value="1"   selected="@(Model.TypeTransportFiltre == 1)">Aller</option>
                        <option value="2"  selected="@(Model.TypeTransportFiltre == 2)">Retour</option>
                    </select>

                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="feather icon-search"></i>
                    </button>

                    @if (!string.IsNullOrEmpty(Model.Recherche) || Model.DateTransportFiltre.HasValue)
                    {
                        <a href="/Transport/HistoriqueTransport" class="btn btn-sm btn-secondary">
                            <i class="feather icon-x"></i>
                        </a>
                    }

                    <div class="btn-group card-option">
                        <button type="button" class="btn dropdown-toggle" data-toggle="dropdown">
                            <i class="feather icon-more-horizontal"></i>
                        </button>
                        <ul class="list-unstyled card-option dropdown-menu dropdown-menu-right">
                            <li class="dropdown-item full-card"><a href="#!"><span><i class="feather icon-maximize"></i> Maximiser</span></a></li>
                            <li class="dropdown-item minimize-card"><a href="#!"><span><i class="feather icon-minus"></i> Réduire</span></a></li>
                            <li class="dropdown-item reload-card"><a href="#!"><i class="feather icon-refresh-cw"></i> Recharger</a></li>
                        </ul>
                    </div>
                </form>

                
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Employé</th>
                            <th>Adresse</th>
                            <th>Site</th>
                            <th>Type Transport</th>
                            <th>Heure</th>
                            <th>Date Transport</th>
                            <th>Date Demande</th>
                            <th>Vehicule</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model._ListeDemandes.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5 text-muted">
                                    <i class="feather icon-check-circle" style="font-size: 2.5rem; color: #28a745;"></i>
                                    <p class="mt-2 mb-0 font-weight-bold">Aucune historique de transport.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var d in Model._ListeDemandes)
                            {
                                <tr>
                                    <td><small class="text-muted">#@d.Id</small></td>

                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar avatar-s mr-2 bg-primary rounded-circle d-flex align-items-center justify-content-center"
                                                 style="width:32px; height:32px; font-size:0.75rem; color:white;">
                                                @(d.Employe?.Prenom?.Substring(0, 1).ToUpper())@(d.Employe?.Nom?.Substring(0, 1).ToUpper())
                                            </div>
                                            <div>
                                                <span class="font-weight-bold">@d.Employe?.NomComplet()</span>
                                                <br />
                                                <small class="text-muted">@d.Employe?.Matricule</small>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <small>@d.Adresse?.Adresse</small>
                                        @if (d.Adresse?.EstPrincipale == true)
                                        {
                                            <span class="badge bg-info ml-1" style="font-size:0.65rem;">Principale</span>
                                        }
                                    </td>

                                    <td>@d.Site?.Nom</td>

                                    <td>
                                        <span class="badge bg-warning">
                                            <i class="feather icon-truck mr-1"></i>
                                            @d.TypeTransport?.Libelle
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge bg-success">
                                            <i class="feather icon-clock mr-1"></i>
                                            @d.HeureTransport?.FormatHeure()
                                        </span>
                                    </td>

                                    <td>
                                        @if (d.DateTransport.HasValue)
                                        {
                                            <span>@d.DateTransport.Value.ToString("dd/MM/yyyy")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>

                                    <td>
                                        <small class="text-muted">@d.DateCreation.ToString("dd/MM/yyyy HH:mm")</small>
                                    </td>

                                    <td>
                                        <span class="badge bg-success">
                                            @d.Vehicule?.Matricule
                                        </span>
                                    </td>

                                    <td>
                                        @* Détail *@
                                        <button class="btn btn-sm btn-info"
                                                title="Détail"
                                                data-toggle="modal"
                                                data-target="#modalDetail"
                                                onclick="openDetail(
                                                    @d.Id,
                                                    '@d.Employe?.NomComplet()',
                                                    '@d.Employe?.Matricule',
                                                    '@d.Adresse?.Adresse',
                                                    '@d.Site?.Nom',
                                                    '@d.TypeTransport?.Libelle',
                                                    '@d.HeureTransport?.FormatHeure()',
                                                    '@d.DateTransport?.ToString("dd/MM/yyyy")',
                                                    '@d.DateCreation.ToString("dd/MM/yyyy HH:mm")',
                                                    '@d.Vehicule?.Matricule'
                                                )">
                                            <i class="feather icon-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @* ===== PAGINATION ===== *@
            @if (Model.TotalPages > 1)
            {
                <div class="p-3">
                    <nav>
                        <ul class="pagination justify-content-end mb-0">

                            <li class="page-item @(Model.PageActuelle == 1 ? "disabled" : "")">
                                <a class="page-link" href="/Transport/HistoriqueTransport?page=1&recherche=@Model.Recherche&dateTransportFiltre=@Model.DateTransportFiltre?.ToString("yyyy-MM-dd")&typeTransportFiltre=@Model.TypeTransportFiltre">
                                    <i class="feather icon-chevrons-left"></i>
                                </a>
                            </li>
                            <li class="page-item @(Model.PageActuelle == 1 ? "disabled" : "")">
                                <a class="page-link" href="/Transport/HistoriqueTransport?page=@(Model.PageActuelle - 1)&recherche=@Model.Recherche&dateTransportFiltre=@Model.DateTransportFiltre?.ToString("yyyy-MM-dd")&typeTransportFiltre=@Model.TypeTransportFiltre">
                                    <i class="feather icon-chevron-left"></i>
                                </a>
                            </li>

                            @{
                                int fenetreSize = 3;
                                int debut = Math.Max(1, Model.PageActuelle - fenetreSize / 2);
                                int fin   = Math.Min(Model.TotalPages, debut + fenetreSize - 1);
                                if (fin - debut + 1 < fenetreSize)
                                    debut = Math.Max(1, fin - fenetreSize + 1);
                            }

                            @if (debut > 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            @for (int i = debut; i <= fin; i++)
                            {
                                <li class="page-item @(i == Model.PageActuelle ? "active" : "")">
                                    <a class="page-link" href="/Transport/HistoriqueTransport?page=@i&recherche=@Model.Recherche&dateTransportFiltre=@Model.DateTransportFiltre?.ToString("yyyy-MM-dd")&typeTransportFiltre=@Model.TypeTransportFiltre">@i</a>
                                </li>
                            }
                            @if (fin < Model.TotalPages)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }

                            <li class="page-item @(Model.PageActuelle == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="/Transport/HistoriqueTransport?page=@(Model.PageActuelle + 1)&recherche=@Model.Recherche&dateTransportFiltre=@Model.DateTransportFiltre?.ToString("yyyy-MM-dd")&typeTransportFiltre=@Model.TypeTransportFiltre">
                                    <i class="feather icon-chevron-right"></i>
                                </a>
                            </li>
                            <li class="page-item @(Model.PageActuelle == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="/Transport/HistoriqueTransport?page=@Model.TotalPages&recherche=@Model.Recherche&dateTransportFiltre=@Model.DateTransportFiltre?.ToString("yyyy-MM-dd")&typeTransportFiltre=@Model.TypeTransportFiltre">
                                    <i class="feather icon-chevrons-right"></i>
                                </a>
                            </li>

                        </ul>
                    </nav>
                    <small class="text-muted">Page @Model.PageActuelle sur @Model.TotalPages</small>
                </div>
            }
        </div>
    </div>
</div>

@* ===================================================== *@
@* MODALE VALIDER *@
@* ===================================================== *@
<div id="modalValider" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">
                    <i class="feather icon-check-circle mr-2"></i> Valider la demande
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <form method="post" asp-page-handler="Valider">
                <input type="hidden" id="validerIdDemande" name="id" />
                <input type="hidden" name="pageActuelle" value="@Model.PageActuelle" />
                <div class="modal-body text-center py-4">
                    <i class="feather icon-check-circle text-success" style="font-size: 2.5rem;"></i>
                    <h5 class="mt-3">Confirmer la validation pour :</h5>
                    <h4 class="font-weight-bold text-success" id="validerNomEmploye"></h4>
                    <p class="text-muted" id="validerDescDemande"></p>
                    <div class="form-group text-left mt-3">
                        <label>Commentaire <small class="text-muted">(optionnel)</small></label>
                        <textarea name="commentaire" class="form-control" rows="2"
                                  placeholder="Ajouter un commentaire..."></textarea>
                    </div>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-secondary px-4" data-dismiss="modal">
                        <i class="feather icon-x mr-1"></i> Annuler
                    </button>
                    <button type="submit" class="btn btn-success px-4">
                        <i class="feather icon-check mr-1"></i> Oui, valider
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ===================================================== *@
@* MODALE REJETER *@
@* ===================================================== *@
<div id="modalRejeter" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="feather icon-x-circle mr-2"></i> Rejeter la demande
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <form method="post" asp-page-handler="Rejeter">
                <input type="hidden" id="rejeterIdDemande" name="id" />
                <input type="hidden" name="pageActuelle" value="@Model.PageActuelle" />
                <div class="modal-body text-center py-4">
                    <i class="feather icon-alert-triangle text-danger" style="font-size: 2.5rem;"></i>
                    <h5 class="mt-3">Confirmer le rejet pour :</h5>
                    <h4 class="font-weight-bold text-danger" id="rejeterNomEmploye"></h4>
                    <p class="text-muted" id="rejeterDescDemande"></p>
                    <div class="form-group text-left mt-3">
                        <label>Motif du rejet <small class="text-muted">(recommandé)</small></label>
                        <textarea name="commentaire" class="form-control" rows="2"
                                  placeholder="Préciser le motif du rejet..."></textarea>
                    </div>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-secondary px-4" data-dismiss="modal">
                        <i class="feather icon-x mr-1"></i> Annuler
                    </button>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="feather icon-x-circle mr-1"></i> Oui, rejeter
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ===================================================== *@
@* MODALE DÉTAIL *@
@* ===================================================== *@
<div id="modalDetail" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">
                    <i class="feather icon-info mr-2"></i> Détail de la demande
                    <span id="detailId" class="ml-2 font-weight-light" style="font-size:0.85rem;"></span>
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <table class="table table-sm table-borderless">
                    <tbody>
                        <tr>
                            <td class="text-muted font-weight-bold" style="width:40%">
                                <i class="feather icon-user mr-1"></i> Employé
                            </td>
                            <td id="detailNom" class="font-weight-bold"></td>
                        </tr>
                        <tr>
                            <td class="text-muted font-weight-bold">
                                <i class="feather icon-credit-card mr-1"></i> Matricule
                            </td>
                            <td id="detailMatricule"></td>
                        </tr>
                        <tr>
                            <td class="text-muted font-weight-bold">
                                <i class="feather icon-map-pin mr-1"></i> Adresse
                            </td>
                            <td id="detailAdresse"></td>
                        </tr>
                        <tr>
                            <td class="text-muted font-weight-bold">
                                <i class="feather icon-home mr-1"></i> Site
                            </td>
                            <td id="detailSite"></td>
                        </tr>
                        <tr>
                            <td class="text-muted font-weight-bold">
                                <i class="feather icon-truck mr-1"></i> Type Transport
                            </td>
                            <td id="detailTypeTransport"></td>
                        </tr>
                        <tr>
                            <td class="text-muted font-weight-bold">
                                <i class="feather icon-clock mr-1"></i> Heure
                            </td>
                            <td id="detailHeure"></td>
                        </tr>
                        <tr>
                            <td class="text-muted font-weight-bold">
                                <i class="feather icon-calendar mr-1"></i> Date Transport
                            </td>
                            <td id="detailDateTransport"></td>
                        </tr>
                        <tr>
                            <td class="text-muted font-weight-bold">
                                <i class="feather icon-plus-circle mr-1"></i> Date Demande
                            </td>
                            <td id="detailDateCreation"></td>
                        </tr>
                        <tr>
                            <td class="text-muted font-weight-bold">
                                <i class="feather icon-check-square mr-1"></i> Vehicule
                            </td>
                            <td id="vehicule"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openValider(id, nom, description) {
        document.getElementById("validerIdDemande").value = id;
        document.getElementById("validerNomEmploye").innerText = nom;
        document.getElementById("validerDescDemande").innerText = description;
    }

    function openRejeter(id, nom, description) {
        document.getElementById("rejeterIdDemande").value = id;
        document.getElementById("rejeterNomEmploye").innerText = nom;
        document.getElementById("rejeterDescDemande").innerText = description;
    }

    function openDetail(id, nom, matricule, adresse, site, typeTransport, heure, dateTransport, dateCreation, vehicule) {
        document.getElementById("detailId").innerText  = "#" + id;
        document.getElementById("detailNom").innerText           = nom;
        document.getElementById("detailMatricule").innerText     = matricule;
        document.getElementById("detailAdresse").innerText       = adresse;
        document.getElementById("detailSite").innerText          = site;
        document.getElementById("detailTypeTransport").innerText = typeTransport;
        document.getElementById("detailHeure").innerText         = heure;
        document.getElementById("detailDateTransport").innerText = dateTransport || "—";
        document.getElementById("detailDateCreation").innerText  = dateCreation;
        document.getElementById("vehicule").innerText  = vehicule;
    }
</script>
}